{
  "name": "WF-E1 Gmail Email Ingest",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        },
        "filters": {
          "readStatus": "unread",
          "labelIds": ["INBOX"]
        },
        "simple": false,
        "options": {}
      },
      "id": "wf-e1-gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/email/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.DOCUAGENT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "message_id", "value": "={{ $json.id }}" },
            { "name": "thread_id",  "value": "={{ $json.threadId }}" },
            { "name": "subject",    "value": "={{ $json.subject }}" },
            { "name": "sender",     "value": "={{ $json.from }}" },
            { "name": "recipient",  "value": "={{ $json.to }}" },
            { "name": "body",       "value": "={{ $json.text }}" },
            { "name": "body_html",  "value": "={{ $json.html }}" }
          ]
        },
        "options": {}
      },
      "id": "wf-e1-ingest",
      "name": "Ingest Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-new",
              "leftValue": "={{ $json.data.was_new }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf-e1-if-new",
      "name": "Is New Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/email/classify/{{ $json.data.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.DOCUAGENT_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "wf-e1-classify",
      "name": "Classify Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 180]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [{ "node": "Ingest Email", "type": "main", "index": 0 }]
      ]
    },
    "Ingest Email": {
      "main": [
        [{ "node": "Is New Email?", "type": "main", "index": 0 }]
      ]
    },
    "Is New Email?": {
      "main": [
        [{ "node": "Classify Email", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-e1-email-ingest-v4",
  "meta": {
    "instanceId": "docuagent-v4",
    "notes": "After import: set Gmail credential, set BACKEND_URL and DOCUAGENT_API_KEY in n8n env vars, activate."
  }
}
