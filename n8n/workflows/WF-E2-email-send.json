{
  "name": "WF-E2 Email Send (Human-Approved Reply)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-send",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf-e2-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 300],
      "webhookId": "wf-e2-email-send-v4"
    },
    {
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.body.recipient }}",
        "subject": "={{ 'Re: ' + $json.body.subject }}",
        "emailType": "text",
        "message": "={{ $json.body.reply }}",
        "options": {}
      },
      "id": "wf-e2-gmail-send",
      "name": "Send Reply via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [280, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.BACKEND_URL }}/email/{{ $('Webhook').item.json.body.email_id }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.DOCUAGENT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "status", "value": "sent" }
          ]
        },
        "options": {}
      },
      "id": "wf-e2-update-status",
      "name": "Update Email Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: true, email_id: $('Webhook').item.json.body.email_id}) }}",
        "options": {}
      },
      "id": "wf-e2-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Send Reply via Gmail", "type": "main", "index": 0 }]
      ]
    },
    "Send Reply via Gmail": {
      "main": [
        [{ "node": "Update Email Status", "type": "main", "index": 0 }]
      ]
    },
    "Update Email Status": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-e2-email-send-v4",
  "meta": {
    "instanceId": "docuagent-v4",
    "notes": "Triggered by backend POST approve. Webhook path: /webhook/email-send. After import: set Gmail credential, activate."
  }
}
